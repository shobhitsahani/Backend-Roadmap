# PostgreSQL connection string used by Drizzle, route handlers and scripts.
DATABASE_URL=postgresql://roadmap:roadmap@localhost:5432/backend_roadmap

# Set to "false" to fully disable the TrackWorld 3D band on the landing page.
# Any other value keeps 3D enabled; client-side gates (reduced motion, Save-Data,
# low hardwareConcurrency and WebGL availability) still apply.
NEXT_PUBLIC_ENABLE_3D=true
